---
import type { Locale } from '../types';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const focusAreas = [
  'Software Architecture',
  'Low-Latency Systems',
  'Real-Time WebSockets',
  'Modern Web Platforms',
  'Applied AI & Agents',
  'Automation Pipelines'
];
---

<section id="about" class="py-16 md:py-20 border-t border-slate-200/80 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left: Story & Engineering Perspective -->
      <div class="lg:col-span-7">
        <p class="font-mono-code text-xs font-semibold uppercase tracking-wider text-blue-600 mb-2">
          {t.about.eyebrow}
        </p>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-6">
          {t.about.title}
        </h2>

        <div class="space-y-4 text-base text-slate-600 leading-relaxed">
          <p>
            {t.about.p1}
          </p>
          <p>
            {t.about.p2}
          </p>
          <p class="font-medium text-slate-800">
            {t.about.p3}
          </p>
        </div>

        <!-- Technical Focus Tags -->
        <div class="mt-8 pt-6 border-t border-slate-200">
          <p class="font-mono-code text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
            {locale === 'en' ? 'Core Areas of Interest' : 'Áreas Principales de Interés'}
          </p>
          <div class="flex flex-wrap gap-2">
            {focusAreas.map((area) => (
              <span class="inline-flex items-center gap-1.5 font-mono-code text-xs px-2.5 py-1 rounded-md bg-white subtle-border text-slate-700">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>{area}</span>
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Tennis & Personal Discipline Card -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl subtle-border p-6 sm:p-7 relative overflow-hidden">
          <div class="absolute top-0 right-0 transform translate-x-2 -translate-y-2 opacity-5 text-slate-900 pointer-events-none">
            <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          </div>

          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200/60 flex items-center justify-center text-blue-600">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <span class="font-mono-code text-xs uppercase tracking-wider text-slate-400 font-semibold">
                {locale === 'en' ? 'Athletics & Character' : 'Deporte y Disciplina'}
              </span>
              <h3 class="text-base font-bold text-slate-900">
                {t.about.tennisTitle}
              </h3>
            </div>
          </div>

          <p class="text-sm text-slate-600 leading-relaxed">
            {t.about.tennisP}
          </p>

          <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-mono-code text-slate-500">
            <span>{locale === 'en' ? 'National Competitor' : 'Competidor Nacional'}</span>
            <span class="text-blue-600 font-semibold">Oviedo · Spain</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

---
import type { Locale } from '../types';
import { certifications } from '../data/certifications';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="certifications" class="py-16 md:py-20 border-t border-slate-200/80 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <p class="font-mono-code text-xs font-semibold uppercase tracking-wider text-blue-600 mb-2">
        {t.certifications.eyebrow}
      </p>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        {t.certifications.title}
      </h2>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        {t.certifications.description}
      </p>
    </div>

    <!-- Data-driven Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {certifications.map((cert) => (
        <div class="bg-white rounded-2xl subtle-border subtle-border-hover p-5 sm:p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="font-mono-code text-[11px] font-semibold px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200/50">
                {cert.organization}
              </span>
              <div class="flex items-center gap-1.5 font-mono-code text-xs text-slate-400">
                {cert.hours && (
                  <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[11px]">
                    {cert.hours}
                  </span>
                )}
                <span>{cert.date}</span>
              </div>
            </div>

            <h3 class="text-base font-bold text-slate-900 leading-snug">
              {cert.title}
            </h3>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-mono-code">
            <span class="text-slate-400">Verified</span>
            {cert.credentialUrl ? (
              <a
                href={cert.credentialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 font-semibold"
              >
                <span>{t.certifications.credentialUrl}</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            ) : (
              <span class="inline-flex items-center gap-1 text-slate-500 text-[11px]">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Accredited</span>
              </span>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

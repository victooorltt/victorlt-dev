---
import type { Locale } from '../types';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const email = 'victorlasheras2006@gmail.com';
---

<section id="contact" class="py-20 md:py-28 border-t border-slate-200/80 scroll-mt-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <p class="font-mono-code text-xs font-semibold uppercase tracking-wider text-blue-600 mb-3">
      {t.contact.eyebrow}
    </p>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900">
      {t.contact.title}
    </h2>

    <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-xl mx-auto leading-relaxed">
      {t.contact.description}
    </p>

    <!-- Email Card -->
    <div class="mt-10 bg-white rounded-2xl subtle-border p-6 sm:p-8 max-w-lg mx-auto shadow-xs">
      <p class="font-mono-code text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">
        {t.contact.email}
      </p>
      
      <a
        href={`mailto:${email}`}
        class="text-lg sm:text-2xl font-bold text-slate-900 hover:text-blue-600 font-mono-code break-all transition-colors block"
      >
        {email}
      </a>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`mailto:${email}`}
          class="inline-flex items-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-semibold text-white bg-slate-900 hover:bg-blue-600 rounded-lg transition-colors shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{locale === 'en' ? 'Send Email' : 'Enviar Correo'}</span>
        </a>

        <button
          id="copy-email-btn"
          type="button"
          data-email={email}
          class="inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
          aria-label={t.contact.copyEmail}
        >
          <svg id="copy-icon" class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-text">{t.contact.copyEmail}</span>
        </button>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 flex justify-center items-center gap-6 text-sm text-slate-600">
        <a
          href="https://www.linkedin.com/in/victor-lasheras"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 hover:text-blue-600 font-medium transition-colors"
        >
          <svg class="w-4 h-4 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.62 1.62 0 1 0 0-3.24 1.62 1.62 0 0 0 0 3.24m1.4 9.74v-8.37H5.06v8.37h2.8z" />
          </svg>
          <span>LinkedIn</span>
        </a>

        <span class="text-slate-300">·</span>

        <a
          href="https://github.com/victooorltt"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 hover:text-slate-900 font-medium transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <!-- Targeted Opportunities Note -->
    <p class="mt-8 font-mono-code text-xs text-slate-500">
      {t.contact.openFor}
    </p>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        const originalText = copyText.textContent;
        copyText.textContent = copyBtn.getAttribute('data-locale') === 'es' ? '¡Copiado!' : 'Copied!';
        copyBtn.classList.add('bg-emerald-50', 'text-emerald-700');

        setTimeout(() => {
          copyText.textContent = originalText;
          copyBtn.classList.remove('bg-emerald-50', 'text-emerald-700');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy email', err);
      }
    });
  }
</script>

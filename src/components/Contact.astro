---
import type { Locale } from '../types';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const email = 'victorlasheras2006@gmail.com';
---

<section id="contact" class="py-14 border-t border-neutral-200/60 scroll-mt-14">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="mb-4">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900">
        {t.contact.title}
      </h2>
    </div>

    <p class="text-sm sm:text-base text-neutral-600 mb-6 max-w-lg">
      {t.contact.description}
    </p>

    <div class="flex flex-wrap items-center gap-6 text-sm">
      <a
        href={`mailto:${email}`}
        class="text-neutral-900 hover:text-blue-600 font-semibold transition-colors"
      >
        {email} ↗
      </a>
      <span class="text-neutral-300">·</span>
      <a
        href="https://www.linkedin.com/in/victor-lasheras"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-600 hover:text-neutral-900 transition-colors"
      >
        LinkedIn ↗
      </a>
      <span class="text-neutral-300">·</span>
      <a
        href="https://github.com/victooorltt"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-600 hover:text-neutral-900 transition-colors"
      >
        GitHub ↗
      </a>
    </div>

  </div>
</section>

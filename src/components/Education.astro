---
import type { Locale } from '../types';
import { education } from '../data/education';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="education" class="py-12 border-t border-neutral-200/60 scroll-mt-14">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="mb-6">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900">
        {t.education.title}
      </h2>
    </div>

    <div class="space-y-4">
      {education.map((item) => (
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-sm">
          <div>
            <span class="font-semibold text-neutral-900">
              {item.degree[locale]}
            </span>
            <span class="text-neutral-400 mx-1.5">·</span>
            <span class="text-neutral-600">
              {item.institution}
            </span>
            <span class="text-neutral-400 mx-1.5">·</span>
            <span class="text-neutral-500">
              {item.status[locale]}
            </span>
          </div>

          <span class="text-xs text-neutral-400 font-medium">
            {item.period}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>

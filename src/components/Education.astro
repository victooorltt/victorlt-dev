---
import type { Locale } from '../types';
import { education } from '../data/education';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="education" class="py-16 md:py-20 border-t border-slate-200/80 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-10">
      <p class="font-mono-code text-xs font-semibold uppercase tracking-wider text-blue-600 mb-2">
        {t.education.eyebrow}
      </p>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        {t.education.title}
      </h2>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        {t.education.description}
      </p>
    </div>

    <!-- Education Card -->
    <div class="space-y-6">
      {education.map((item) => (
        <div class="bg-white rounded-2xl subtle-border subtle-border-hover p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-lg sm:text-xl font-bold text-slate-900">
                  {item.degree[locale]}
                </h3>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200/60 font-mono-code">
                  {item.status[locale]}
                </span>
              </div>
              <p class="mt-1 text-sm font-semibold text-slate-700">
                {item.institution}
              </p>
              <p class="text-xs font-mono-code text-slate-500">
                {item.location}
              </p>
            </div>

            <div class="flex sm:flex-col sm:items-end justify-between items-center">
              <span class="font-mono-code text-xs font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-700 border border-slate-200/60">
                {item.period}
              </span>
            </div>
          </div>

          {item.details && item.details[locale] && (
            <div class="mt-4">
              <ul class="space-y-2">
                {item.details[locale].map((point) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-600 leading-snug">
                    <span class="text-blue-600 mt-1 flex-shrink-0">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

---
import type { Locale } from '../types';
import { experience } from '../data/experience';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="experience" class="py-12 border-t border-neutral-200/60 scroll-mt-14">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="mb-8">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900">
        {t.experience.title}
      </h2>
    </div>

    <div class="space-y-6">
      {experience.map((item) => (
        <div class="bg-white rounded-xl border border-neutral-200/80 p-6 sm:p-7">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
            <div>
              <span class="text-base font-semibold text-neutral-900">
                {item.role[locale]}
              </span>
              <span class="text-neutral-400 mx-1.5">·</span>
              <a
                href={item.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base font-semibold text-blue-600 hover:text-blue-700 transition-colors"
              >
                {item.company} ↗
              </a>
            </div>

            <span class="text-xs font-medium text-neutral-400">
              {item.period[locale]}
            </span>
          </div>

          <p class="text-sm text-neutral-600 leading-relaxed mb-4">
            {item.summary[locale]}
          </p>

          <div class="flex flex-wrap gap-1.5 text-[11px] text-neutral-500 font-medium">
            {item.technologies.map((tech) => (
              <span class="px-2 py-0.5 rounded bg-neutral-100 text-neutral-700">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

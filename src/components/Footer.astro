---
import type { Locale } from '../types';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer class="py-8 border-t border-neutral-200/60 text-xs text-neutral-400">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 flex items-center justify-between">
    <p>
      © {currentYear} Víctor Lasheras Tejedor
    </p>

    <a href="#top" class="hover:text-neutral-900 transition-colors">
      ↑ {locale === 'en' ? 'Top' : 'Arriba'}
    </a>
  </div>
</footer>

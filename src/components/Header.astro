---
import type { Locale } from '../types';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { label: t.nav.work, href: '#work' },
  { label: t.nav.experience, href: '#experience' },
  { label: t.nav.about, href: '#about' },
  { label: t.nav.contact, href: '#contact' },
];

const targetEnUrl = '/';
const targetEsUrl = '/es';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#fafafa]/90 border-b border-neutral-200/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Brand Name -->
    <a href={locale === 'es' ? '/es' : '/'} class="text-sm font-semibold text-neutral-900 hover:text-neutral-600 transition-colors">
      Víctor Lasheras
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden sm:flex items-center gap-6" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-xs font-medium text-neutral-500 hover:text-neutral-900 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Language Switcher & CV -->
    <div class="flex items-center gap-4 text-xs font-medium">
      <div class="flex items-center gap-1 text-neutral-400">
        <a
          href={targetEnUrl}
          class={`hover:text-neutral-900 transition-colors ${locale === 'en' ? 'text-neutral-900 font-semibold' : ''}`}
        >
          EN
        </a>
        <span>/</span>
        <a
          href={targetEsUrl}
          class={`hover:text-neutral-900 transition-colors ${locale === 'es' ? 'text-neutral-900 font-semibold' : ''}`}
        >
          ES
        </a>
      </div>

      <a
        href="/Victor_Lasheras_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-900 hover:text-blue-600 font-semibold transition-colors"
      >
        CV ↗
      </a>
    </div>
  </div>
</header>

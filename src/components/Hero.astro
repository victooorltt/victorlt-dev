---
import type { Locale } from '../types';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="pt-14 pb-16 sm:pt-20 sm:pb-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center flex flex-col items-center">
    
    <!-- Top Text -->
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900">
      {t.hero.name}
    </h1>

    <p class="mt-2 text-base sm:text-lg font-medium text-neutral-600">
      {t.hero.badge}
    </p>

    <p class="mt-2 text-sm sm:text-base text-neutral-500 max-w-lg">
      {t.hero.thesis}
    </p>

    <p class="mt-1 text-xs text-neutral-400">
      {t.hero.location}
    </p>

    <!-- Center Photo -->
    <div class="my-6">
      <img
        src="/images/victor.jpg"
        alt="Víctor Lasheras Tejedor"
        width="140"
        height="140"
        loading="eager"
        decoding="async"
        class="w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover object-center border border-neutral-200 shadow-sm"
      />
    </div>

    <!-- Below Links: GitHub, LinkedIn, Email, CV -->
    <div class="flex flex-wrap items-center justify-center gap-5 text-sm">
      <a
        href="https://github.com/victooorltt"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-600 hover:text-neutral-900 font-medium transition-colors"
      >
        GitHub ↗
      </a>
      <span class="text-neutral-300">·</span>
      <a
        href="https://www.linkedin.com/in/victor-lasheras"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-600 hover:text-neutral-900 font-medium transition-colors"
      >
        LinkedIn ↗
      </a>
      <span class="text-neutral-300">·</span>
      <a
        href="mailto:victorlasheras2006@gmail.com"
        class="text-neutral-600 hover:text-neutral-900 font-medium transition-colors"
      >
        Email ↗
      </a>
      <span class="text-neutral-300">·</span>
      <a
        href="/Victor_Lasheras_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-900 hover:text-blue-600 font-semibold transition-colors"
      >
        {t.hero.downloadCv} ↓
      </a>
    </div>

  </div>
</section>

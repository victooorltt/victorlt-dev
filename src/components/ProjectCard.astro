---
import type { Project, Locale } from '../types';
import { useTranslations } from '../i18n/translations';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);

const description = project.description[locale];
const technicalPoints = project.technicalPoints[locale];
---

<article class="bg-white rounded-xl border border-neutral-200/80 p-6 sm:p-7 flex flex-col justify-between">
  <div>
    <!-- Header: Title, Year, Links -->
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h3 class="text-lg font-semibold text-neutral-900">
          {project.title}
        </h3>
        <p class="text-xs text-neutral-400 mt-0.5 font-medium">
          {project.period}
        </p>
      </div>

      <div class="flex items-center gap-3 text-xs font-medium">
        {project.githubUrl && (
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-600 hover:text-neutral-900 transition-colors"
          >
            GitHub ↗
          </a>
        )}
        {project.liveUrl && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-600 hover:text-blue-700 transition-colors"
          >
            Web ↗
          </a>
        )}
        {project.isPrivate && (
          <span class="text-neutral-400 text-[11px]">
            {t.work.privateRepo}
          </span>
        )}
      </div>
    </div>

    <!-- Description -->
    <p class="text-sm text-neutral-600 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Technical points -->
    <ul class="space-y-1.5 text-xs text-neutral-500 mb-6">
      {technicalPoints.map((point) => (
        <li class="flex items-start gap-2">
          <span class="text-neutral-300 select-none">•</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Tech tags -->
  <div class="pt-4 border-t border-neutral-100 flex flex-wrap gap-1.5 text-[11px] text-neutral-500 font-medium">
    {project.technologies.map((tech, index) => (
      <span class="px-2 py-0.5 rounded bg-neutral-100 text-neutral-700">
        {tech}
      </span>
    ))}
  </div>
</article>

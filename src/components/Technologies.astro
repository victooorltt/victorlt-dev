---
import type { Locale } from '../types';
import { techGroups } from '../data/technologies';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="technologies" class="py-16 md:py-20 border-t border-slate-200/80 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <p class="font-mono-code text-xs font-semibold uppercase tracking-wider text-blue-600 mb-2">
        {t.technologies.eyebrow}
      </p>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        {t.technologies.title}
      </h2>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        {t.technologies.description}
      </p>
    </div>

    <!-- Tech Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {techGroups.map((group) => (
        <div class="bg-white rounded-2xl subtle-border subtle-border-hover p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
              <h3 class="font-semibold text-slate-900 text-sm tracking-tight">
                {group.category[locale]}
              </h3>
              <span class="font-mono-code text-[11px] text-slate-400 font-medium">
                {group.skills.length} tools
              </span>
            </div>

            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="font-mono-code text-xs px-2.5 py-1 rounded-md bg-slate-50 text-slate-700 subtle-border hover:bg-white hover:text-blue-600 hover:border-blue-200 transition-colors">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

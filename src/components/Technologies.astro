---
import type { Locale } from '../types';
import { techGroups } from '../data/technologies';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="technologies" class="py-12 border-t border-neutral-200/60 scroll-mt-14">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="mb-6">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900">
        {t.technologies.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
      {techGroups.map((group) => (
        <div>
          <h3 class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-2">
            {group.category[locale]}
          </h3>
          <p class="text-neutral-700 leading-relaxed font-medium">
            {group.skills.join(' · ')}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
